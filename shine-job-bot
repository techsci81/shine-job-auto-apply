def extract_alertcards(driver, driver_page_source):    
    soup = BeautifulSoup(driver_page_source, "html.parser")
    # Find all h3 elements with itemprop="name" and a title attribute
    alert_divs = soup.find_all(
    "h3",
    attrs={"itemprop": "name"},
    title=True
    )
    alert_title_list = []
    for h3 in alert_divs:
        alert_title_list.append(h3.get("title"))      # from the title attribute
        alert_body_text = h3.get_text(strip=True)  # visible text inside <span>
        #print(alert_body_text)
        #print(alert_title_list[-1])  # print the last added title
    print(f"Total number of alerts: {len(alert_title_list)}")
    return alert_title_list
