def joblink_apply_button(driver, timeout=10):
    """Click the Apply button using class-based selectors (no ID)."""
    try:
        apply_button = WebDriverWait(driver, timeout).until(
            EC.element_to_be_clickable(
                (By.XPATH, "//button[contains(text(),'Apply') or contains(@id, 'id_apply_')]")
            )
        )
        apply_button.click()
        print("Clicked Apply button.")
        return True
    except Exception as e:
        print(f"Could not click Apply button: {e}")
        return False


def write_application_report(report_rows, output_file="shine_applied_jobs_report.csv"):
    with open(output_file, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["timestamp", "job_title", "status", "url", "notes"])
        writer.writerows(report_rows)
    print(f"Application report saved to {output_file}")
    return output_file

