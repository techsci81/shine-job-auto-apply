def click_view_jobs_buttons(driver, alert_title_list, timeout=10):
    """
    Reusable function to click 'View Jobs' buttons for all alerts in the list.
    
    Args:
        driver: Selenium WebDriver instance
        alert_title_list: list of alert titles (strings)
        timeout: max wait time for locating elements
    """
    
    for alert_title in alert_title_list[0:1]:  # Click only the first alert
        try:
            # Locate the alert card by its <h3> title
            alert_card = WebDriverWait(driver, timeout).until(
                EC.presence_of_element_located(
                    (By.XPATH, f"//h3[@title='{alert_title}']")
                )
            )
            # From the card, navigate up to parent container and find the button
            view_jobs_button = alert_card.find_element(
                By.XPATH,
                "./ancestor::div[contains(@class,'jobCardNova_bigCard__W2xn3')]"
                "//button[contains(@class,'jobCardNova_jfyViewJobsBtn')]"
            )
            view_jobs_button.click()
            print(f"Clicked 'View Jobs' for alert: {alert_title}")

        except Exception as e:
            print(f"Could not click 'View Jobs' for '{alert_title}': {e}")
