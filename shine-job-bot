def extract_alert_result_cards(driver, url):
    driver.get(url)
    time.sleep(2)
    soup = BeautifulSoup(driver.page_source, "html.parser")
    alert_divs = soup.find_all("div", attrs={"data-card-index": True})
    result_divs = []
    for idx, alert_div in enumerate(alert_divs, start=1):
        alert_body_text = alert_div.get_text(strip=True)
        alert_title = alert_div.get("data-card-index")
        alert_link_tag = alert_div.find("a", href=True)
        alert_link = alert_link_tag["href"] if alert_link_tag else None
        result_divs.append([idx, alert_title, alert_body_text, alert_link])
    return result_divs

