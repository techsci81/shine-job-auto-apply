### EXTRACT ALL ALERT RESULT CARDS TOTAL PAGES
def parse_all_job_cards(driver, output_file='shine_jobs.csv'):
    hrefs = extract_pagination_links(driver)
    all_results = []
    p = 3  # number of pages to scrape
    for h in hrefs[:p]:  # limit to first p pages
        all_results.extend(extract_alert_result_cards(driver, h))

    with open(output_file, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["CardIndex", "Title", "Text", "Link"])
        writer.writerows(all_results)
        print(f"Job cards up to page {p} saved to {output_file}")

    return all_results

