##  third job apply 
def apply20jobs(driver, job_rows, report_file="shine_applied_jobs_report.csv"):
    report_rows = []
    for row in job_rows: # replace --> for row in job_rows[:n] to limit with first n jobs posted
        card_index, title, text, link = row
        if not link:
            continue

        try:
            driver.execute_script("window.open('');")
            driver.switch_to.window(driver.window_handles[-1])
            driver.get(link)
            time.sleep(4)
            actions = ActionChains(driver)
            actions.send_keys(Keys.END).perform()
            time.sleep(4)
            applied = joblink_apply_button(driver)
            status = "applied" if applied else "not_applied"
            notes = "Apply button clicked" if applied else "Apply button not found or not clickable"
        except Exception as exc:
            status = "error"
            notes = str(exc)
        finally:
            if len(driver.window_handles) > 1:
                driver.close()
                driver.switch_to.window(driver.window_handles[0])

        report_rows.append([
            datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            text or title or "Unknown job",
            status,
            link,
            notes,
        ])

    return write_application_report(report_rows, output_file=report_file)

