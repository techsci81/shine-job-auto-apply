### extract_pagination_link
def extract_pagination_links(driver):
    base_url = driver.current_url
    pagination_items = driver.find_elements(By.XPATH, "//ul[contains(@class,'paginationNova')]//li")

    print(f"Found {len(pagination_items)} pagination items.")

    # Extract numeric page values
    page_numbers = []
    for item in pagination_items:
        text = item.text.strip()
        if text.isdigit():
            page_numbers.append(int(text))

    max_page = max(page_numbers) if page_numbers else 1
    print(f"Detected max page: {max_page}")

    # Build all pagination links from 1 to max_page
    hrefs = []
    for i in range(1, max_page + 1):
        if i == 1:
            hrefs.append(base_url)
        else:
            hrefs.append(f"{base_url}-{i}")

    return hrefs

